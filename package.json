{
  "name": "monkey-mayhem-backend",
  "version": "1.0.0",
  "description": "Membership management API for Monkey Mayhem Fight Club",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "seed": "node seed.js",
    "test": "node --test",
    "build:exe": "node scripts/build-exe.mjs"
  },
  "pkg": {
