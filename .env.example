# Copy this file to ".env" and fill in your values.

# --- PostgreSQL connection (match what you set up in pgAdmin) ---
PGHOST=localhost
PGPORT=5432
PGDATABASE=monkey_mayhem
PGUSER=postgres
PGPASSWORD=your_postgres_password
# Set 1 when the managed PostgreSQL provider requires TLS (for example Supabase).
# Certificate verification remains enabled.
PGSSL=

# --- Auth ---
# Use a long random string in production.
JWT_SECRET=change-this-to-a-long-random-secret
# 8h is a reasonable maximum for a staff session.
JWT_EXPIRES_IN=8h

# --- First admin account (created by `npm run seed`) ---
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=monkey123
SEED_ADMIN_NAME=Gym Admin

# --- Google reviews on the public website (optional) ---
# Both must be set before the site shows live Google reviews; without them it
# falls back to the curated quotes in the frontend's siteData.js.
#   GOOGLE_MAPS_API_KEY  A Maps Platform key with the "Places API (New)"
#                        enabled. Restrict it to that API in Cloud Console.
#   GOOGLE_PLACE_ID      The club's place ID. Find it with Google's Place ID
#                        Finder, or a Text Search — a Maps URL's "0x...:0x..."
#                        CID is NOT a place ID and will not work here.
# Cost: Place Details with reviews bills at $25/1000 calls (1,000 free a month),
# so an uncached public page costs roughly a call per visitor.
GOOGLE_MAPS_API_KEY=
GOOGLE_PLACE_ID=

# Photos from the Google listing. OFF by default: each photo costs a SEPARATE
# billed call ($7/1000). Set 1-10 to enable. Images load in the visitor's
# browser straight from Google's CDN — we never re-host them, because the Maps
# Platform terms forbid it and photo links expire.
GOOGLE_PLACES_PHOTOS=0
GOOGLE_PLACES_PHOTO_WIDTH=1200

# Seconds to hold Google's response in memory. LEAVE AT 0 unless you have
# decided otherwise: Maps Platform Terms 3.2.3(b) permit no caching of review
# text. Raising it trades contract compliance for a smaller bill.
GOOGLE_PLACES_CACHE_SECONDS=0

# --- Server ---
PORT=4000
# Set to 1 when behind a reverse proxy/CDN; otherwise all clients share one
# rate-limit bucket.
TRUST_PROXY=
# Same slug as the frontend's VITE_ADMIN_PATH; exe-only.
ADMIN_PATH=
# Where the React dev server runs, for CORS.
CLIENT_ORIGIN=http://localhost:5173
